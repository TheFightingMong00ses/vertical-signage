{
  "name": "vertical-signage",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "lint": "eslint .",
    "lint:html": "htmlhint \"src/**/*.html\"",
    "format": "prettier --write .",
