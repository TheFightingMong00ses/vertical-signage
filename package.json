  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.2.0",
    "htmlhint": "^1.9.2",
    "jest": "^30.3.0",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
